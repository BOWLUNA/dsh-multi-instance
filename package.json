{
  "name": "dsh-multi-instance",
  "version": "0.5.0",
  "description": "DeepSeek Harness 多实例桌面客户端：把 dsh web 装进原生 webview 窗口，按 URL 接入多个实例 —— 本机、WSL2、服务器都行。分屏平铺、自由排布、每格独立会话。｜Multi-instance desktop client & webview shell for DeepSeek Harness (dsh) - multi-window panes, tiling layout, isolated session per pane.",
  "main": "src/main/main.js",
  "bin": {
    "dsh-multi-instance": "bin/cli.js"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "BOWLUNA",
    "email": "ai@bowluna.com"
  },
  "homepage": "https://github.com/BOWLUNA/dsh-multi-instance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOWLUNA/dsh-multi-instance.git"
  },
  "bugs": {
    "url": "https://github.com/BOWLUNA/dsh-multi-instance/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-client",
    "dsh-desktop",
    "dsh-multi-instance",
    "electron",
    "webview",
    "desktop",
    "desktop-app",
    "desktop-client",
    "gui",
    "multi-instance",
    "multi-window",
    "multi-agent",
    "multi-session",
    "multi-pane",
    "multi-tab",
    "pane",
    "pane-layout",
    "tiling",
    "tile-window-manager",
    "split-view",
    "layout",
    "workspace",
    "window-manager",
    "tab-manager",
    "wsl",
    "wsl2",
    "windows",
    "remote",
    "ssh",
    "url-attach",
    "browser-shell",
    "webview-shell",
    "web-wrapper",
    "client",
    "ai",
    "ai-agent",
    "llm",
    "cli-gui",
    "多开",
    "多实例",
    "多窗口",
    "分屏",
    "平铺",
    "桌面客户端",
    "套壳",
    "远程"
  ],
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --devtools",
    "start:demo": "electron . --demo",
    "test": "node tests/run.js",
    "smoke": "node tools/smoke.js",
    "check:assets": "node tools/check-binary-assets.js",
    "selftest": "electron . --selftest",
    "selftest:side": "electron . --selftest-side",
    "selftest:win": "electron . --selftest-win",
    "selftest:tip": "electron . --selftest-tip",
    "memtest": "electron . --memtest",
    "clean:dist": "node tools/clean-dist.js",
    "predist": "node tools/clean-dist.js",
    "dist": "electron-builder --win --publish never",
    "predist:zip": "node tools/clean-dist.js",
    "dist:zip": "electron-builder --win zip --publish never",
    "predist:setup": "node tools/clean-dist.js",
    "dist:setup": "electron-builder --win nsis --publish never"
  },
  "files": [
    "src/",
    "bin/",
    "tests/",
    "build/icon.ico",
    "start.cmd",
    "start.sh",
    "start.vbs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "build": {
    "appId": "com.bowluna.dsh-multi-instance",
    "productName": "DSH Multi-Instance",
    "copyright": "Copyright © 2026 BOWLUNA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "start.cmd",
      "start.sh",
      "start.vbs",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Multi-Instance",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "DSH Multi-Instance ${version}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=18"
  }
}
